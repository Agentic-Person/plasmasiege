# Environment Variables Template
# Copy this file to .env and replace all values with your actual configuration
# NEVER commit .env files to version control!

# N8N Configuration
N8N_ENCRYPTION_KEY=replace_with_32_character_encryption_key
POSTGRES_PASSWORD=replace_with_secure_postgres_password

# Supabase Configuration  
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Solana Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
PLASMA_TOKEN_MINT=your_plasma_token_mint_address_here
SHIP_COLLECTION_ADDRESS=your_nft_collection_address_here
TREASURY_WALLET_PRIVATE_KEY=your_treasury_wallet_private_key_here

# Unity Webhook Configuration
WEBHOOK_SECRET=your_secure_webhook_secret_here

# Instructions:
# 1. Copy this file: cp env.template .env
# 2. Replace all placeholder values with your actual configuration
# 3. Never commit .env files to git - they are automatically ignored 